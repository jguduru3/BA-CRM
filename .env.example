# Copy to .env (never commit .env) and replace every "change_me".
# Generate secrets with:  openssl rand -hex 32
# Full reference: DEPLOYMENT.md → "Environment variables".

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crm
DB_USER=crm
DB_PASS=change_me
DB_POOL_SIZE=15

# ── Security (required — the API refuses to start with missing/weak values) ──
# JWT signing secret, 32+ random bytes. Changing it signs everyone out.
JWT_SECRET=change_me
# AES-256-GCM key for secrets stored in the DB (AI keys, WhatsApp tokens, SMTP
# passwords, webhook secrets). 32+ random bytes, different from JWT_SECRET.
# (APP_ENCRYPTION_KEY is still accepted as a legacy name.)
ENCRYPTION_KEY=change_me
# Only while rotating ENCRYPTION_KEY: the previous key (decrypt-only). See DEPLOYMENT.md.
ENCRYPTION_KEY_PREVIOUS=
# Session length in ms (default 12h).
JWT_EXPIRATION_MS=43200000

# First start only: sets the seeded admin@betteranalytics.in password (a change is
# still forced at first sign-in). Remove after the first successful sign-in.
BOOTSTRAP_ADMIN_PASSWORD=

# Browser origins allowed to call the API cross-origin (comma-separated).
# Leave empty when the frontend is served from the same origin (the default setup).
CORS_ALLOWED_ORIGINS=

# Public Swagger UI / OpenAPI spec at /api/docs (contains no data). false to hide.
API_DOCS_ENABLED=true

# Rate limits
RATE_LIMIT_PER_IP_PER_MINUTE=1200
RATE_LIMIT_API_KEY_PER_MINUTE=600
RATE_LIMIT_LOGIN_PER_IP_PER_MINUTE=20
RATE_LIMIT_LOGIN_PER_EMAIL=10

# ── Optional Redis (shared rate limits + permission cache across replicas) ────
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# ── Optional Azure Application Insights ───────────────────────────────────────
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Host port for the web container (docker compose)
WEB_PORT=8081

# ── WhatsApp Cloud API ─────────────────────────────────────────────────────────
WHATSAPP_GRAPH_URL=https://graph.facebook.com/v19.0
# Meta App Secret — required to verify inbound webhook signatures (X-Hub-Signature-256).
WHATSAPP_APP_SECRET=

# ── Web push via Azure Notification Hubs (optional; blank disables push) ──────
# Hub → Settings → Browser (Web Push): set a VAPID key pair; put its PUBLIC key below.
AZURE_NOTIFICATION_HUB_CONNECTION_STRING=
AZURE_NOTIFICATION_HUB_NAME=
WEBPUSH_VAPID_PUBLIC_KEY=

# ── File/image attachment storage ───────────────────────────────────────────────
# Local disk is the default. Set AZURE_STORAGE_CONNECTION_STRING to use Azure Blob.
LOCAL_UPLOAD_DIR=./data/uploads
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=bettercrm-docs
AZURE_KEYVAULT_URI=

# ── AI (Claude / GPT) ─────────────────────────────────────────────────────────
# Configured per organization at runtime (Settings → AI Assistant), not here.
